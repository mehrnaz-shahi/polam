{
  "expo": {
    "name": "پولام",
    "slug": "poolaki-offline",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "poolaki",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9FAFB",
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "imageWidth": 280,
          "dark": { "backgroundColor": "#111827" }
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true },
    "android": { "package": "com.poolaki.offline" },
    "web": { "bundler": "metro" }
  }
}
